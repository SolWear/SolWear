{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/dev.sh:*)",
      "Bash(./scripts/dev.sh:*)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm --prefix:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(node store/registry/validate.mjs)",
      "Bash(node store/registry/test.mjs)",
      "Bash(node store/registry/verify-packages.mjs:*)",
      "Bash(node docs/build.mjs)",
      "Bash(tests/e2e/run.sh:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": []
  }
}
